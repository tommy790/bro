// V-NPCs GPU belly deformer (reference HLSL).
// Runtime deformation is applied in Lua:
//   sh_vnpc_gpu_belly.lua     - virtual bones, struggle/gulp sync
//   sh_vnpc_gpu_belly_fx.lua  - torso hull, peristalsis, silhouette, jiggle, shape
// Engine VCS compile is still optional (build_gpu_vore_shader.bat). Stock
// VertexLitGeneric will not run this file; the Lua mesh is the working path.

float4 g_VoreStomachCenter : register(c190);
float4 g_VoreParams        : register(c191); // x=radius y=intensity z=preg w=prey
float4 g_VoreSpot[4]       : register(c192); // xyz=world pos  w=radius
float4 g_VoreSpotAmp       : register(c196);
float4 g_VoreGulp[4]       : register(c197);
float4 g_VoreGulpAmp       : register(c201);
float4 g_VoreJiggle        : register(c202);

float3 ApplyVoreVertexDeformation(float3 worldPos, float3 worldNormal, float3 center, float radius, float intensity)
{
    float dist = length(worldPos - center);
    float gaussian = exp(-((dist * dist) / (2.0 * radius * radius + 0.001)));
    float factor = saturate(1.0 - dist / (radius * 1.35)) * gaussian;
    float3 outDir = normalize(worldPos - center + worldNormal * 0.25);
    return worldPos + outDir * (factor * intensity);
}

float3 ApplyPreySilhouetteSpots(float3 worldPos, float3 worldNormal)
{
    float3 pos = worldPos;
    float amps[4] = { g_VoreSpotAmp.x, g_VoreSpotAmp.y, g_VoreSpotAmp.z, g_VoreSpotAmp.w };
    [unroll] for (int i = 0; i < 4; i++)
    {
        float amp = amps[i];
        if (amp <= 0.001) continue;
        float3 spot = g_VoreSpot[i].xyz;
        float radius = max(g_VoreSpot[i].w, 0.5);
        float dist = length(worldPos - spot);
        if (dist < radius)
        {
            float gaussian = exp(-((dist * dist) / (2.0 * radius * radius + 0.001)));
            float factor = saturate(1.0 - dist / radius) * gaussian;
            float3 outDir = normalize(worldPos - spot + worldNormal * 0.35);
            pos += outDir * (factor * amp * radius);
        }
    }
    return pos;
}

float3 ApplyPeristalsisWave(float3 worldPos, float3 worldNormal)
{
    float3 pos = worldPos;
    float amps[4] = { g_VoreGulpAmp.x, g_VoreGulpAmp.y, g_VoreGulpAmp.z, g_VoreGulpAmp.w };
    [unroll] for (int i = 0; i < 4; i++)
    {
        float amp = amps[i];
        if (amp <= 0.001) continue;
        float3 gulpPos = g_VoreGulp[i].xyz;
        float radius = max(g_VoreGulp[i].w, 0.5);
        float dist = length(worldPos - gulpPos);
        if (dist >= radius) continue;
        float gaussian = exp(-((dist * dist) / (2.0 * radius * radius + 0.001)));
        float factor = saturate(1.0 - dist / radius) * gaussian;
        float3 outDir = normalize(worldPos - gulpPos + worldNormal * 0.25);
        pos += outDir * (factor * amp * radius);
    }
    return pos;
}

float3 ApplyBellyJiggle(float3 worldPos)
{
    return worldPos + g_VoreJiggle.xyz;
}

float3 ApplyPregPreyShape(float3 worldPos, float3 center, float3 up, float3 forward, float radius)
{
    float preg = saturate(g_VoreParams.z);
    float prey = saturate(g_VoreParams.w);
    float3 rel = worldPos - center;
    float h = dot(rel, up) / max(radius, 0.1);
    // pregnancy lifts mass; swallowed prey drops and pushes forward
    worldPos += up * (preg * radius * 0.18 * saturate(0.4 - h));
    worldPos -= up * (prey * radius * 0.14 * saturate(h + 0.2));
    worldPos += forward * (prey * radius * 0.08 * saturate(h + 0.35));
    return worldPos;
}
